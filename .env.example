# ============================================================================
#  hls-dl - cau hinh. Dien vao day, khong can sua code.
#
#  Khong can dau ngoac kep tru khi gia tri co khoang trang o dau/cuoi.
#  Dong bat dau bang # la ghi chu. De trong = dung mac dinh.
#  File nay chua COOKIE (= phien dang nhap cua ban) -> dung commit len git.
# ============================================================================


# --- 1. Trang tac pham ------------------------------------------------------

# URL trang tac pham (trang liet ke cac tap). BAT BUOC cho auto_grab.js.
# Vi du: https://pocketfm.com/show/<ma-show>
# Tai nhieu tac pham cung luc: ngan cach bang dau phay.
SHOW_URL=

# Khoang tap can lay. De trong ca hai = lay tat ca (nhung bi chan boi MAX_EP).
# Bo dai co the hon 1000 tap nen NEN dat khoang.
FROM_EP=1
TO_EP=

# Tran an toan: nhieu hon so nay thi auto_grab.js tu choi chay va bao ban dat
# khoang, thay vi lang le bam ca nghin tap va tai hang tram GB.
MAX_EP=100

# Tap tra phi khong phat duoc nen khong sinh ra link. Sau bao nhieu tap lien
# tiep that bai thi coi nhu het phan mien phi va dung lai?
STOP_AFTER_FAILS=3

# Goc cua site. De trong thi suy ra tu SHOW_URL.
SITE_URL=


# --- 2. Nhan dien ten tap ---------------------------------------------------
#
# Ten tap dang "E1. Just an Old Book" thuong nam trong the <span> KHONG co class,
# nen bam theo MAU CHU chac hon bam theo class. Mac dinh duoi day nhan duoc:
#   E1. ...   Ep 2 - ...   Episode 3: ...   Tap 4. ...   Chuong 5) ...
# De trong = dung mac dinh. Chi sua neu site cua ban danh so kieu khac.
EPISODE_TITLE_RE=

# Neu tu nhan dang sai, chi dinh thang selector cua cac tap.
# Kiem tra trong Console: document.querySelectorAll('<selector>').length
# De trong = tu nhan dang theo EPISODE_TITLE_RE o tren.
EPISODE_SELECTOR=

# Noi chua ten tac pham (dung lam ten thu muc).
# De trong -> tu thu aria-label, roi den <h1>, roi den tieu de trang.
SERIES_TITLE_SELECTOR=

# Ep cung ten tac pham, bo qua moi thu tu dong o tren. Thuong khong can.
SERIES_NAME=

# Nut Play. De trong -> tu tim the <video> roi goi .play(). Thuong la du.
PLAY_SELECTOR=


# --- 3. Dat ten file --------------------------------------------------------

# Cac bien dung duoc: {index} {title} {series}
#
#   {index:03d} - {title}   ->  001 - E1. Ten tap.mp4     (mac dinh)
#   {title}                 ->  E1. Ten tap.mp4
#   {series} - {title}      ->  Ten tac pham - E1. Ten tap.mp4
#
# Nen giu {index:03d} o dau: ten tap co san so nhung File Explorer sap xep theo
# chu cai, thanh ra E1, E10, E11, E2 - dung so zero-pad moi ra dung thu tu.
NAME_TEMPLATE={index:03d} - {title}

# true = moi tac pham mot thu muc rieng ben trong OUTPUT_DIR:
#   <OUTPUT_DIR>/<ten tac pham>/001 - E1. Ten tap.mp4
GROUP_BY_SERIES=true


# --- 4. Dang nhap -----------------------------------------------------------

# Chi can neu chay hls_dl.py truc tiep ma site doi dang nhap.
# Lay bang cach go  HLS.cookie()  trong Console sau khi da dan grab.js.
# auto_grab.js KHONG can cai nay - no giu phien dang nhap trong BROWSER_PROFILE.
COOKIE=

# Header xac thuc neu site dung token thay vi cookie.
# Vi du: AUTH_HEADER=Authorization: Bearer eyJhbGci...
AUTH_HEADER=

# Referer gui kem khi tai manh .ts. Nhieu CDN chan neu thieu.
# De trong -> tu dung SHOW_URL.
REFERER=


# --- 5. Tai xuong -----------------------------------------------------------

# Thu muc luu video. Vi du: /duong/dan/toi/Videos
OUTPUT_DIR=./videos

# File manifest do grab.js / auto_grab.js sinh ra.
MANIFEST=./manifest.json

# So manh tai song song. Ha xuong 3-4 neu bi chan hoac loi nhieu.
WORKERS=8

# So lan thu lai moi manh truoc khi bo cuoc.
RETRIES=5

# Sau khi ghep xong, doi chieu thoi luong file that voi tong #EXTINF trong
# playlist. Lech vua thi canh bao, lech nhieu thi bao loi va xoa file hong.
# Day la thu bat duoc loai loi nguy hiem nhat: loai khong kem theo thong bao.
VERIFY_OUTPUT=true


# --- 5b. Day len cloud roi xoa ban local -----------------------------------
#
# De trong = khong upload, video nam lai trong OUTPUT_DIR.
#
# Can cai rclone truoc (mot lan):
#     winget install Rclone.Rclone
#     rclone config          -> tao remote ten "gdrive", loai "drive"
#
# Cach chay: tai xong MOT tap thi day ngay tap do len roi xoa ban local, nen
# o dia luc nao cung chi giu mot tap (~110 MB) chu khong phai ca 6 GB.
# Dung "rclone moveto" - no chi xoa ban local SAU KHI day len thanh cong.

# Ten remote trong rclone config.
UPLOAD_TO=

# ID thu muc Drive dich = doan cuoi cua URL thu muc.
# https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXXXXXXXXXXXXX
#                                        ^--------- doan nay --------^
DRIVE_FOLDER_ID=

# Muon dung cong cu khac rclone thi dat lenh o day, {file} = duong dan day du,
# {name} = ten file. Dat cai nay thi UPLOAD_TO va DRIVE_FOLDER_ID bi bo qua.
UPLOAD_CMD=


# --- 6. Playwright (chi auto_grab.js dung) ---------------------------------

# Noi luu phien dang nhap. Dang nhap mot lan, cac lan sau tu dong.
BROWSER_PROFILE=./browser-profile

# true = chay an, khong hien trinh duyet. Lan dau nen de false de con dang nhap.
HEADLESS=false

# Cho toi da bao lau (ms) cho moi tap truoc khi coi nhu that bai.
# Mang cham hoac player tai lau thi tang len 30000-40000.
WAIT_MS=20000

# Cho them (ms) sau khi bat duoc link, phong truong hop playlist dau la quang cao.
SETTLE_MS=1500
